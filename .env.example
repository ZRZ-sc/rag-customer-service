# ===== LLM (DeepSeek) =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=30

# ===== 本地嵌入 / 重排模型 =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== PostgreSQL =====
PG_HOST=localhost
PG_PORT=5432
PG_USER=rag
PG_PASSWORD=ragpass
PG_DATABASE=rag

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Milvus =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=faq_embeddings

# ===== 认证 =====
API_TOKEN=dev-token-change-me

# ===== RAG 参数 =====
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true
TOP_K_CANDIDATES=50
TOP_K_FINAL=5
MULTI_QUERY_COUNT=3
CONFIDENCE_THRESHOLD=0.5

# ===== 缓存优化（阶段3）=====
REWRITE_CACHE_TTL_SECONDS=86400      # 上下文改写结果缓存
TRANSFORM_CACHE_TTL_SECONDS=86400    # Multi-Query/HyDE 扩展缓存
RERANK_CACHE_TTL_SECONDS=86400       # 重排结果缓存（知识库变更时失效）
RERANK_MAX_CANDIDATES=12             # 送入 Cross-Encoder 的候选上限

# ===== 快速路径（高置信直出）=====
FAST_PATH_ENABLED=true
FAST_PATH_MIN_SCORE=0.80             # top1 向量相似度阈值
FAST_PATH_MIN_MARGIN=0.05            # top1 与 top2 最小分差
FAST_PATH_RERANK_TOPK=5

# ===== 资源与运维开关 =====
PRELOAD_MODELS=true                  # 启动即加载本地模型（占 ~1.2GB；低内存可设 false 改为懒加载）
DIALOGUE_LOG_ENABLED=true            # 每请求写问答日志（高并发可关闭以减轻 PG 写压力）
AUTH_DEBUG_LOG=false                 # 打印明文 Authorization 头（仅排查用，生产必须 false）

# ===== 限流（429）=====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300            # 单身份每分钟请求数（令牌补充速率）
RATE_LIMIT_BURST=60                  # 单身份突发容量
RATE_LIMIT_GLOBAL_PER_MINUTE=0       # 全局每分钟上限（0=关闭；用于保护 CPU 密集实例）
RATE_LIMIT_GLOBAL_BURST=0

# ===== 转人工（F6）=====
HUMAN_HANDOFF_ENABLED=true
HANDOFF_AUTO_ON_LOW_CONFIDENCE=true  # 低置信度自动建单
HANDOFF_WEBHOOK_URL=                 # 预留：推送到人工客服系统的回调地址（留空则不推送）
HANDOFF_WEBHOOK_TIMEOUT=5

# ===== 会话 =====
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=10

# ===== 可观测性 (可选) =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-customer-service
